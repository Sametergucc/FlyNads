# Copy to .env.local after the contract is deployed.
VITE_CONTRACT_ADDRESS=
VITE_ROUND_ID=1
VITE_LEGACY_CONTRACT_ADDRESSES=

# When the frontend is hosted separately (e.g. Vercel), set this to the game
# server's public URL so API calls reach the right backend.
# Leave empty when using `npm run dev` (the Vite proxy handles it).
# Example: VITE_SERVER_URL=https://your-server.ngrok-free.app
VITE_SERVER_URL=

# Deployment/operator keys are used only by scripts. Never put these in VITE_* variables.
MONAD_PRIVATE_KEY=
MONAD_CONTRACT_ADDRESS=
